{
  "name": "tarkovdex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx scripts/migrate-live-db.ts",
    "db:verify-live": "tsx scripts/verify-live-db.ts",
    "smoke:live-admin": "tsx scripts/smoke-live-admin.ts",
    "smoke:production": "tsx scripts/smoke-production-routes.ts",
    "news:legacy:audit": "tsx --conditions react-server scripts/news-legacy-audit.ts",
    "news:legacy:archive": "tsx --conditions react-server scripts/news-legacy-audit.ts --archive",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit:armor": "tsx scripts/audit-armor-data.ts",
    "validate:quest-links": "tsx scripts/validate-quest-links.ts",
    "validate:quest-links:network": "tsx scripts/validate-quest-links.ts --network",
    "test": "tsx --conditions react-server --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.22",
    "next-intl": "^4.13.4",
    "postgres": "^3.4.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
