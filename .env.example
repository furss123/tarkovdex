# ---------------------------------------------------------------------------
# TarkovDex environment
#
# Every NEXT_PUBLIC_* value is inlined at build time — setting one in Vercel
# requires a redeploy before it takes effect. Note also that a dashboard-
# configured project env var takes precedence over vercel.json's `env` block,
# which has silently no-op'd a domain change here before.
# ---------------------------------------------------------------------------

# Canonical origin. Drives metadataBase, robots.txt, sitemap.xml and every
# canonical/hreflang URL. Defaults to https://tarkovdex.dev when unset.
NEXT_PUBLIC_SITE_URL=https://tarkovdex.dev

# ---------------------------------------------------------------------------
# Advertising (optional — everything ad-related is inert until CLIENT is set)
#
# With NEXT_PUBLIC_ADSENSE_CLIENT empty, no third-party script loads and the
# in-content slot renders nothing at all. That is the correct state until
# AdSense approves the site.
#
# Before applying, also replace the placeholder publisher id in public/ads.txt
# and uncomment that line.
# ---------------------------------------------------------------------------

# Publisher id, e.g. ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_CLIENT=

# Slot id for the single in-content unit on the dashboard
NEXT_PUBLIC_ADSENSE_SLOT_MAIN=

# ---------------------------------------------------------------------------
# Contact address published on /privacy. Required by ad-network review, and
# the only way a user can act on a data request. Defaults to the owner's
# address when unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
