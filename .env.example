# TarkovDex environment variables
#
# The json.tarkov.dev static JSON API needs no authentication and has no
# configurable base URL in this project (see src/lib/tarkov.ts).

# Production origin — used by robots.ts/sitemap.ts and generateMetadata's
# metadataBase. https://tarkovdex.dev is the canonical domain (see
# src/lib/site.ts); override only for previews or local testing.
NEXT_PUBLIC_SITE_URL=https://tarkovdex.dev

# Phase 8 PWA kill switch. Production registers `/sw.js` when unset or "true".
# Set to "false" to stop new registrations, unregister existing workers on
# next visit, and clear TarkovDex Cache Storage entries. See
# docs/operations/tarkovdex-pwa.md.
NEXT_PUBLIC_PWA_ENABLED=

# ---------------------------------------------------------------------------
# Tarkov Live (the /news situation board). See docs/tarkov-live.md.
#
# EVERYTHING BELOW IS OPTIONAL. With an empty environment the site still builds,
# type-checks, tests and renders: the board falls back to Steam's official feed
# plus committed files, automatic collection is off, and the admin screen
# refuses to log anyone in. Full operation needs, at minimum, DATABASE_URL +
# CRON_SECRET + TARKOV_LIVE_ADMIN_SECRET.
# ---------------------------------------------------------------------------

# --- Storage ---------------------------------------------------------------
# Any Postgres (Neon, Supabase, Vercel Postgres, self-hosted). Use the POOLED
# connection string on serverless. POSTGRES_URL is read as a fallback, which is
# the variable Vercel's own Postgres integration injects.
# Production migrations prefer the direct, non-pooling URL below. Runtime
# functions continue to use DATABASE_URL. Never expose either variable with a
# NEXT_PUBLIC_ prefix.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Automatic collection --------------------------------------------------
# Required. The cron endpoint (/api/cron/tarkov-live) authenticates with
# `Authorization: Bearer $CRON_SECRET` and refuses every request when unset.
# Use a long random value: `openssl rand -hex 32`.
CRON_SECRET=
# Master switch for collection. Leave empty (= on) unless pausing ingestion.
LIVE_INGESTION_ENABLED=
# How long without a successful collection before the board tells users the data
# may be behind, instead of reporting "no events" as a finding.
# Daily Vercel Hobby cron plus two hours of scheduling tolerance. Lower this
# when an external scheduler or a Pro-plan cron runs collection more often.
LIVE_STALE_AFTER_MINUTES=1560
# How close to an event's end counts as "ending soon".
LIVE_ENDING_SOON_HOURS=6
# Whole-run budget in ms; keeps one slow source from eating the function timeout.
LIVE_MAX_RUN_MS=50000

# --- Admin review desk (/{locale}/admin/live) ------------------------------
# Required for the review UI. A long random value, never a memorable password:
# `openssl rand -hex 32`. Unset = the admin screen is disabled entirely.
TARKOV_LIVE_ADMIN_SECRET=
# Optional separate key for signing the session cookie. Falls back to the admin
# secret; setting both is preferred so either can be rotated on its own.
TARKOV_LIVE_SESSION_SECRET=
# Session lifetime in hours.
TARKOV_LIVE_SESSION_HOURS=12

# --- X (Twitter) API v2 ----------------------------------------------------
# Both collectors (@tarkov and Nikita) are skipped unless X_API_ENABLED is
# truthy AND a bearer token is present. Server-only: the token is never inlined
# into a client bundle and never logged.
X_API_ENABLED=
X_BEARER_TOKEN=
# Handles without the leading @. Change these rather than editing code.
X_TARKOV_USERNAME=tarkov
X_NIKITA_USERNAME=nikgeneburn
# Cost control. The interval is a floor per account, independent of how often the
# cron fires. Pages are only followed once a cursor exists, so the first sync
# after a fresh deployment is always a single page, never a whole timeline.
X_FETCH_INTERVAL_MINUTES=10
X_MAX_POSTS_PER_FETCH=10
X_MAX_PAGES_PER_FETCH=2
# Filters. Replies and plain reposts are off by default; official accounts
# quote-post real announcements often enough to keep quotes on.
X_INCLUDE_REPLIES=
X_INCLUDE_REPOSTS=
X_INCLUDE_QUOTES=true

# --- Telegram --------------------------------------------------------------
# Reserved. The seam exists but has no collector: there is no stable, legitimate
# way to read the history of a public channel we do not own. Turning this on only
# produces a "source unavailable" notice. See docs/tarkov-live.md.
TELEGRAM_ENABLED=
TELEGRAM_CHANNEL=escapefromtarkovEN

# --- AI interpretation -----------------------------------------------------
# Summary / player-impact / recommended-action prose, plus evidence-backed entity
# and time extraction. Runs in the cron only, never during a page render — one
# call covers all three locales. Without GEMINI_API_KEY the board shows the
# original post text instead.
LIVE_INTERPRET_ENABLED=
LIVE_INTERPRET_MAX_ITEMS=8
LIVE_INTERPRET_MODEL=gemini-3.5-flash-lite

# --- Development -----------------------------------------------------------
# Seed entries so the whole pipeline can be exercised with no credentials.
# Defaults to on outside production; never defaults on in a production build.
LIVE_FIXTURES=

# Optional. Powers the news page's automatic ko/zh translation of Escape from
# Tarkov's official Steam news feed (see src/lib/translate-news.ts) and the
# Tarkov Live interpretation layer (src/lib/live/interpret.ts). Without this set,
# Steam posts fall back to the committed translations and then to the original
# English. Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
